    ]
  },
  "failure_conditions": [
    "A woven host that is not cyclically 4-edge-connected, or a woven instance that is not certified Pfaffian.",
    "A ladder site or cube junction with a subset containing a cycle and fewer than four boundary edges.",
    "A single-site interpolation inside a woven instance that misses the count with that site restored."
  ],
